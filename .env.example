# Local Supabase: run `npx supabase status` and copy API_URL, ANON_KEY and SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional locally: without it, AI calls fail and features use their fallback (see S0-B1).
ANTHROPIC_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
